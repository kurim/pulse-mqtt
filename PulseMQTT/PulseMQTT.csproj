<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PulseMQTT</AssemblyName>
    <RootNamespace>PulseMQTT</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Platforms>x64</Platforms>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      GC auf geringen Speicherverbrauch statt Durchsatz ausrichten:
      Workstation-GC ohne Background-Thread reicht für eine Tray-App
      völlig aus und spart dauerhaft committeten Heap-Speicher.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ConserveMemory (0-9): höhere Werte lassen den GC Segmente aggressiver
      zurückgeben und den Heap kleiner halten – auf Kosten etwas häufigerer
      Collections, was hier (Poll alle 1-2 s, sonst idle) egal ist.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!--
    Trimming-Konfiguration (nur aktiv wenn PublishTrimmed=true).

    Strategie: alle Assemblies die Reflection nutzen oder für die der Trimmer
    keine vollständige Analyse liefert, werden als Root-Assemblies markiert
    → sie bleiben vollständig erhalten. Getrimmt wird nur ungenutzte
    .NET-Runtime-Code, das spart typisch 25-35 MB.
  -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!--
      Unterdrückt "Windows Forms wird nicht unterstützt"-Fehler.
      WinForms ist unten als TrimmerRootAssembly vollständig geschützt,
      sodass keine Laufzeitfehler durch fehlende Typen entstehen.
    -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- WinForms: Trimmer-Analyse nicht unterstützt → komplett schützen -->
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Drawing" />
    <!-- Hardware-Monitoring und MQTT nutzen Reflection -->
    <TrimmerRootAssembly Include="LibreHardwareMonitorLib" />
    <TrimmerRootAssembly Include="MQTTnet" />
    <TrimmerRootAssembly Include="MQTTnet.Server" />
    <!-- Service-Controller für PawnIO-Erkennung -->
    <TrimmerRootAssembly Include="System.ServiceProcess.ServiceController" />
    <!-- Laufwerks-Sensoren über WMI -->
    <TrimmerRootAssembly Include="System.Management" />
    <!-- USB/Seriell-Ausgabe -->
    <TrimmerRootAssembly Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet"        Version="5.*" />
    <PackageReference Include="MQTTnet.Server" Version="5.*" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.*" />
    <PackageReference Include="System.Management" Version="8.*" />
    <!-- DPAPI-Verschlüsselung des MQTT-Passworts in settings.json -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
    <!-- Kein eigener PackageReference nötig: LibreHardwareMonitorLib bringt bereits
         eine neuere System.IO.Ports-Version transitiv mit; ein Pin hier würde sie
         nur downgraden (NU1605). -->
  </ItemGroup>

  <Target Name="RemoveMonoPosixHelpers" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').Contains('MonoPosixHelper'))" />
    </ItemGroup>
  </Target>

</Project>
